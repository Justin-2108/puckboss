rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagueMembers/$(request.auth.uid + '_' + leagueId));
    }

    // Server-side kickoff times for the games currently in games.json.
    // The browser can never change these values.
    function kickoff(gameId) {
      return gameId == '2026-09-17_EBB_STR' ? timestamp.value(1789666200000) :
        gameId == '2026-09-18_KHA_GW' ? timestamp.value(1789752600000) :
        gameId == '2026-09-18_NIT_AEV' ? timestamp.value(1789752600000) :
        gameId == '2026-09-18_KEV_PEB' ? timestamp.value(1789752600000) :
        gameId == '2026-09-18_ISE_ING' ? timestamp.value(1789752600000) :
        gameId == '2026-09-18_MUC_MAN' ? timestamp.value(1789752600000) :
        gameId == '2026-09-18_SWW_LF' ? timestamp.value(1789752600000) :
        timestamp.value(0);
    }

    function validTip() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.home is int
        && request.resource.data.away is int
        && request.resource.data.home >= 0
        && request.resource.data.home <= 10
        && request.resource.data.away >= 0
        && request.resource.data.away <= 10;
    }

    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /leagueCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.leagueId is string;
      allow update, delete: if false;
    }

    match /leagueMembers/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.leagueId is string;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /leagueTips/{leagueId}/users/{uid} {
      allow read: if isMember(leagueId);
      allow write: if false;
    }

    match /leagueTips/{leagueId}/users/{uid}/games/{gameId} {
      allow read: if isMember(leagueId);
      allow create, update: if isMember(leagueId)
        && uid == request.auth.uid
        && request.time < kickoff(gameId)
        && validTip();
      allow delete: if isMember(leagueId)
        && uid == request.auth.uid
        && request.time < kickoff(gameId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
