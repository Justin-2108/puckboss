rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(leagueId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leagueMembers/$(request.auth.uid + '_' + leagueId));
    }

    // The server-side kickoff time comes from the synchronized games document.
    // This keeps the lock tied to the official schedule instead of a hardcoded list.
    function kickoff(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data.kickoffAt;
    }

    function validTip() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.home is int
        && request.resource.data.away is int
        && request.resource.data.home >= 0
        && request.resource.data.home <= 10
        && request.resource.data.away >= 0
        && request.resource.data.away <= 10;
    }

    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /leagueCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.leagueId is string;
      allow update, delete: if false;
    }

    match /leagueMembers/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.leagueId is string;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /leagueTips/{leagueId}/users/{uid} {
      allow read: if isMember(leagueId);
      allow write: if false;
    }

    match /leagueTips/{leagueId}/users/{uid}/games/{gameId} {
      allow read: if isMember(leagueId);
      allow create, update: if isMember(leagueId)
        && uid == request.auth.uid
        && request.time < kickoff(gameId)
        && validTip();
      allow delete: if isMember(leagueId)
        && uid == request.auth.uid
        && request.time < kickoff(gameId);
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
